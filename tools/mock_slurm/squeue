#!/usr/bin/env python3
"""mock squeue: -h -r [-u USER] [-n NAMES] [-j IDS] [-o FORMAT] (supports %F %K %T %A %i %j)"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _mockslurm as m  # noqa: E402

args = sys.argv[1:]


def opt(flag):
    for i, a in enumerate(args):
        if a == flag and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(flag + "="):
            return a.split("=", 1)[1]
    return None


if m.faults().get("squeue_fail"):
    print("squeue: error: slurm_load_jobs error: Socket timed out", file=sys.stderr)
    sys.exit(1)
fmt = opt("-o") or "%i %T"
names = set((opt("-n") or "").split(",")) - {""}
ids = set((opt("-j") or "").split(",")) - {""}
for aj, job in sorted(m.read_state()["jobs"].items()):
    if not m.visible(job) or (names and job["name"] not in names) or (ids and aj not in ids):
        continue
    for idx, el in sorted(job["elements"].items(), key=lambda kv: int(kv[0])):
        if el["state"] not in ("PENDING", "RUNNING"):
            continue
        line = fmt
        for code, value in (("%F", aj), ("%K", idx), ("%T", el["state"]), ("%A", str(el["raw"])),
                            ("%i", "%s_%s" % (aj, idx)), ("%j", job["name"])):
            line = line.replace(code, value)
        print(line)
