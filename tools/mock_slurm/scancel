#!/usr/bin/env python3
"""mock scancel: IDS (ARRAYJOB or ARRAYJOB_INDEX)"""
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _mockslurm as m  # noqa: E402

with m.locked() as st:
    for target in sys.argv[1:]:
        aj, _, idx = target.partition("_")
        job = st["jobs"].get(aj)
        if not job:
            continue
        for i, el in job["elements"].items():
            if idx and i != idx:
                continue
            if el["state"] in ("PENDING", "RUNNING"):
                el["cancel"] = True
                if el["state"] == "RUNNING" and el.get("pid"):
                    try:
                        os.killpg(el["pid"], signal.SIGTERM)
                        el["signalled"] = True
                    except ProcessLookupError:
                        pass
